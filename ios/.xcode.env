# The `.xcode.env` file is stored in git and sets the environment
# for script phases in Xcode.
# To customize the environment locally, create `.xcode.env.local`,
# which is not stored in git.

# The NODE_BINARY variable holds the path to the node executable.
#
# Override NODE_BINARY here.
# For example, for nvm from brew, add the line
# . "$(brew --prefix nvm)/nvm.sh" --no-use
export NODE_BINARY=$(command -v node)
