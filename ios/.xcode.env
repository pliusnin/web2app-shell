# Файл `.xcode.env` хранится в git и задаёт окружение
# для script phases в Xcode.
# Для локальной настройки окружения создайте `.xcode.env.local`,
# он в git не хранится.

# Переменная NODE_BINARY содержит путь к исполняемому файлу node.
#
# Переопределите NODE_BINARY здесь.
# Например, для nvm из brew добавьте строку
# . "$(brew --prefix nvm)/nvm.sh" --no-use
export NODE_BINARY=$(command -v node)
