    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-native-vector-icons/get-image": "^13.0.1",
    "@react-native-vector-icons/material-design-icons": "^13.1.4",
    "@sbaiahmed1/react-native-biometrics": "^0.16.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-blob-util": "^0.25.1",
