    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "lint:fix": "eslint . --fix",
    "lint:fsd": "steiger ./packages/web2app-shell/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "patch-package --patch-dir packages/web2app-shell/patches",
    "setup": "node packages/web2app-shell/scripts/setup.mjs"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.40.3",
